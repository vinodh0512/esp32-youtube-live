# Environment Variables for Render & Local Development

YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

PORT=10000
NODE_ENV=production

# Optional MongoDB Connection for Persistent History
MONGODB_URI=

# Polling Interval (Seconds) when stream is offline (Default: 30)
LIVE_CHECK_INTERVAL_SECONDS=30
